{
  "name": "@votrix/managed-agents-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Fumadocs documentation site for Votrix Managed Agents (VMA)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --webpack",
    "start": "serve out",
    "build": "next build --webpack",
    "postbuild": "node scripts/materialize-markdown.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx && patch-package",
    "openapi:export": "cd .. && uv run python scripts/export_openapi.py",
    "openapi:sync": "npm run openapi:export"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@orama/orama": "^3.1.18",
    "cnfast": "^0.0.8",
    "fumadocs-core": "16.11.4",
    "fumadocs-mdx": "15.1.1",
    "fumadocs-openapi": "11.2.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.11.4",
    "geist": "^1.7.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "4.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.10",
    "patch-package": "8.0.1",
    "postcss": "^8.5.19",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0"
  }
}
