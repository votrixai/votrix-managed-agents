# Local default. In staging and production, use a managed Postgres instance.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/votrix_managed_agents
DATABASE_URL=sqlite+aiosqlite:///./votrix_managed_agents.db

APP_ENV=local
LOG_LEVEL=INFO

# Deep Agents is the execution harness. Model credentials remain server-owned.
VMA_RUNTIME_BACKEND=deepagents
VMA_DEFAULT_MODEL_PROVIDER=anthropic
VMA_DEFAULT_ANTHROPIC_MODEL=claude-sonnet-4-6
VMA_DEFAULT_OPENAI_MODEL=gpt-5.5
VMA_DEFAULT_DEEPSEEK_MODEL=deepseek-chat

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_USE_RESPONSES=false
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=

# JSON registry for additional server-approved providers. Each entry may set
# adapter, api_key_env, base_url, default_model, model_kwargs, and capabilities.
# OpenAI-compatible endpoints should use adapter "openai" and disable the
# Responses API in model_kwargs unless the endpoint explicitly supports it.
VMA_MODEL_PROVIDERS={}

# Leave empty to derive a durable checkpointer from DATABASE_URL.
VMA_CHECKPOINT_DATABASE_URL=
VMA_MAX_GRAPH_STEPS=250
VMA_RUN_TIMEOUT_SECONDS=900

# Safe default: checkpointed files without shell execution. Set `e2b` to
# provision exactly one persistent E2B sandbox per cloud Session.
VMA_SANDBOX_PROVIDER=state
E2B_API_KEY=
E2B_DOMAIN=
E2B_API_URL=
E2B_SANDBOX_URL=
# Required when VMA_SANDBOX_PROVIDER=e2b. This must be an operator-owned
# hardened template whose default guest is non-root and cannot use sudo.
VMA_E2B_TEMPLATE=
VMA_E2B_WORKDIR=/workspace
VMA_E2B_GUEST_USER=user
VMA_E2B_TIMEOUT_SECONDS=900
VMA_E2B_AUTO_PAUSE=true
VMA_E2B_AUTO_RESUME=false
VMA_E2B_KEEP_MEMORY=true
VMA_E2B_PAUSE_ON_EXIT=true
VMA_E2B_ALLOW_PUBLIC_TRAFFIC=false
VMA_E2B_TEMPLATE_RESOURCES={}
VMA_SANDBOX_COMMAND_TIMEOUT_SECONDS=900
VMA_SANDBOX_RETENTION_SECONDS=2592000
VMA_SANDBOX_JANITOR_INTERVAL_SECONDS=60

# A custom backend factory remains available for non-E2B providers.
VMA_SANDBOX_FACTORY=
# Running tenant code in the control-plane process is unsafe and opt-in only.
VMA_ALLOW_UNSAFE_LOCAL_SANDBOX=false
VMA_SANDBOX_ROOT=/workspace

# Configure one key or a comma-separated set. The JSON map binds each key to a
# workspace without exposing workspace IDs in API paths.
VMA_API_KEY=
VMA_API_KEYS=
VMA_API_KEY_WORKSPACES={}
VMA_DEFAULT_WORKSPACE_ID=wrkspc_default
# Anonymous access is accepted only when APP_ENV is local/test.
VMA_ALLOW_ANONYMOUS_LOCAL=true
VMA_REQUIRE_BETA_HEADER=true
VMA_REQUIRE_ANTHROPIC_VERSION_HEADER=true
VMA_PUBLIC_BASE_URL=https://example.invalid

# Optional shared token for self-hosted work queue routes.
VMA_WORKER_TOKEN=

# AES-256-GCM at-rest encryption for vault credential secrets.
# Required when APP_ENV is not local/test.
# Generate one with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
VMA_ENCRYPTION_KEY=
VMA_ALLOW_PLAINTEXT_SECRETS_LOCAL=true

# S3-compatible storage for files, skill archives, and generated artifacts.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=
S3_REGION=auto
