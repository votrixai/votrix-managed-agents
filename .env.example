# Active Votrix Managed Agents configuration.
#
# Copy this file to .env and fill only the integrations you use. The active
# settings model is app/config.py. Unsupported variables that are not listed
# here are omitted because Settings(extra="ignore") would silently discard them.

# Release identity. Hosted deployments inject the build and commit values.
APP_ENV=local
VMA_PUBLIC_BUILD_ID=dev
VMA_GIT_COMMIT_SHA=

# Relational state. SQLite is the zero-infrastructure development default.
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/votrix_managed_agents
DATABASE_URL=sqlite+aiosqlite:///./votrix_managed_agents.db

# One server-owned key per model provider. Configure only providers used by
# Agent model IDs. API callers select a model; they never supply these keys.
OPENROUTER_MANAGEMENT_KEY=
VMA_ENCRYPTION_KEY=

# E2B is the rewrite's only sandbox provider. A Session is provisioned when it
# is created, so end-to-end Session use requires this key. Memory Stores reuse
# the same key and additionally require E2B Volumes to be enabled for the E2B
# project; there is no separate Volume credential.
E2B_API_KEY=
SANDBOX_TIMEOUT_SECONDS=900
SANDBOX_COMMAND_TIMEOUT_SECONDS=300

# Private S3-compatible storage. Required for Files, Skills, attached inputs,
# and collected outputs. S3_ENDPOINT_URL may be blank for AWS S3.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Short-lived transfer URLs and output collection bounds.
TRANSFER_URL_TTL_SECONDS=600
MAX_OUTPUT_FILES=50
MAX_OUTPUT_BYTES=104857600

# PostgreSQL application pool. SQLite ignores these sizes and uses NullPool.
# VMA_DB_POOL_SIZE=0 also selects NullPool for PostgreSQL.
VMA_DB_POOL_SIZE=5
VMA_DB_MAX_OVERFLOW=5
VMA_DB_POOL_TIMEOUT_SECONDS=10
VMA_DB_POOL_RECYCLE_SECONDS=300
VMA_DB_POOL_PRE_PING=true

# Turn dispatch. "inline" executes inside the API request and needs no queue.
TURN_DISPATCH=inline

# Required together only when TURN_DISPATCH=cloud. Cloud Tasks sends an
# OIDC-authenticated POST to WORKER_URL/internal/sessions/{id}/process.
TASKS_PROJECT=
TASKS_LOCATION=
TASKS_QUEUE=
TASKS_SERVICE_ACCOUNT=
WORKER_URL=
