# VMA local development configuration.
# Copy this file to .env, fill only the values required by your selected
# provider/features, and never commit the resulting .env file.

# =============================================================================
# REQUIRED OR CONDITIONALLY REQUIRED
# =============================================================================

# Required for durable control-plane state. The checked-in SQLite value is a
# usable local default. For Supabase, use its session-pooler URL on port 5432:
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./votrix_managed_agents.db

# Required for model execution: select one route and fill only the matching
# credential. Built-in routes are anthropic, openai, and deepseek. The
# server-approved OpenRouter route registered below is the deployment default.
VMA_DEFAULT_MODEL_PROVIDER=openrouter
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Required only when the selected provider is a custom alias. Keep this JSON on
# one line; it contains environment-variable names, never credential values.
VMA_MODEL_PROVIDERS={"openrouter":{"adapter":"openrouter","api_key_env":"OPENROUTER_API_KEY","base_url":"https://openrouter.ai/api/v1","default_model":"deepseek/deepseek-v4-pro","model_kwargs":{"openrouter_provider":{"order":["fireworks","together"],"only":["fireworks","together"],"allow_fallbacks":true,"require_parameters":true,"data_collection":"deny"}},"capabilities":{"streaming":true,"tool_calls":true,"multimodal_input":false,"reasoning":true,"native_structured_output":false}}}

# Required only for E2B-backed Sessions. Keep `state` for a local run without
# shell/filesystem execution. The E2B template must be operator-owned, non-root,
# and unable to use sudo.
VMA_SANDBOX_PROVIDER=state
E2B_API_KEY=
VMA_E2B_TEMPLATE=

# Authentication uses database-backed workspace keys in local, development,
# staging, and production. After migrations, create the first key with
# `python -m scripts.bootstrap_api_key`; no authentication secret belongs in
# this process environment. Configure encryption before storing Vault secrets.
VMA_ENCRYPTION_KEY=

# Required only when using Files, Skill archives, or artifact export. Keep the
# bucket private; clients upload with presigned PUTs and download through VMA.
# Endpoint is required for R2 and similar services, but may be blank for AWS.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# =============================================================================
# OPTIONAL OVERRIDES AND TUNING
# =============================================================================

# Process and observability defaults.
APP_ENV=local
LOG_LEVEL=INFO
SENTRY_DSN=

# Model-specific defaults and compatible endpoint overrides.
VMA_DEFAULT_ANTHROPIC_MODEL=claude-sonnet-4-6
VMA_DEFAULT_OPENAI_MODEL=gpt-5.5
VMA_DEFAULT_DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
OPENAI_USE_RESPONSES=false
DEEPSEEK_API_BASE=

# Optional advanced override. Leave empty to derive the LangGraph checkpoint
# connection from DATABASE_URL automatically; no second database is needed.
VMA_CHECKPOINT_DATABASE_URL=
VMA_MAX_GRAPH_STEPS=250
VMA_RUN_TIMEOUT_SECONDS=900

# Sandbox and E2B overrides.
E2B_DOMAIN=
E2B_API_URL=
E2B_SANDBOX_URL=
VMA_E2B_WORKDIR=/workspace
VMA_E2B_GUEST_USER=user
VMA_E2B_TIMEOUT_SECONDS=900
VMA_E2B_AUTO_PAUSE=true
VMA_E2B_AUTO_RESUME=false
VMA_E2B_KEEP_MEMORY=true
VMA_E2B_PAUSE_ON_EXIT=true
VMA_E2B_ALLOW_PUBLIC_TRAFFIC=false
VMA_E2B_TEMPLATE_RESOURCES={"cpu":2,"memory_mb":2048}
# Best-effort internal estimates only; these are not customer billing rates.
VMA_E2B_COST_ESTIMATION_ENABLED=true
VMA_E2B_VCPU_SECOND_USD=0.000014
VMA_E2B_GIB_SECOND_USD=0.0000045
VMA_SANDBOX_COMMAND_TIMEOUT_SECONDS=900
VMA_SANDBOX_RETENTION_SECONDS=2592000
VMA_SANDBOX_JANITOR_INTERVAL_SECONDS=60
VMA_SANDBOX_FACTORY=
VMA_ALLOW_UNSAFE_LOCAL_SANDBOX=false
VMA_SANDBOX_ROOT=/workspace

# Protocol, embedded-worker, and governance behavior.
VMA_REQUIRE_BETA_HEADER=true
VMA_REQUIRE_ANTHROPIC_VERSION_HEADER=true
VMA_EMBEDDED_WORKER_ENABLED=false
VMA_WORKER_CONCURRENCY=1
VMA_WORKER_POLL_INTERVAL_SECONDS=0.5
VMA_WORKER_LEASE_SECONDS=120
VMA_PUBLIC_GA_ONLY=false
# Comma-separated exact browser origins. Leave empty for server-to-server only.
VMA_CORS_ORIGINS=
VMA_GOVERNANCE_ENABLED=true
VMA_REQUESTS_PER_MINUTE=120
VMA_MAX_ACTIVE_WORK=5
VMA_DAILY_MODEL_TOKENS=1000000
VMA_WORKSPACE_STORAGE_BYTES=5368709120
VMA_ALLOW_PLAINTEXT_SECRETS_LOCAL=true

# Runtime I/O and polling limits.
VMA_WEB_FETCH_MAX_BYTES=1000000
VMA_WEB_SEARCH_ENDPOINT=
VMA_WEB_ALLOW_PRIVATE_NETWORKS=false
VMA_EVENT_POLL_INTERVAL_SECONDS=0.5
VMA_MAX_FILE_UPLOAD_BYTES=52428800
VMA_MAX_SESSION_INPUT_BYTES=536870912
VMA_MAX_SKILL_ARCHIVE_BYTES=26214400

# Object-storage tuning.
S3_REGION=auto
