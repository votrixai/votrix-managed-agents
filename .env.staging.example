# Copy to .env.staging, replace every placeholder, and never commit it.
# Run scripts/gcloud/1-create-secrets.sh with --suffix staging.

# =============================================================================
# REQUIRED FOR THE STANDARD STAGING CLOUD RUN PROFILE
# =============================================================================

# Dedicated staging Supabase project, Supavisor session mode (:5432).
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# Bootstrap the first database-backed staging tenant key after migrations with
# `python -m scripts.bootstrap_api_key`; no shared API key secret is imported.
VMA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-staging-key
E2B_API_KEY=replace-with-e2b-api-key

# Keep this bucket private; do not enable r2.dev or a public custom domain.
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace-with-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-storage-secret-key
S3_BUCKET_NAME=votrix-managed-agents-staging

# =============================================================================
# OPTIONAL
# =============================================================================

# Runtime toggles such as VMA_EMBEDDED_WORKER_ENABLED, VMA_PUBLIC_GA_ONLY, and
# VMA_CORS_ORIGINS are pinned in service.staging.yaml, not imported as secrets.
# VMA derives LangGraph's checkpoint connection from DATABASE_URL.
