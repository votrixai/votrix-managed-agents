{
  "name": "@votrix/managed-agents",
  "version": "0.1.0",
  "description": "TypeScript SDK for Votrix Managed Agents (VMA)",
  "license": "UNLICENSED",
  "author": "Votrix",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://votrixai.com",
  "keywords": [
    "votrix",
    "managed-agents",
    "agents",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "npm@11.11.0",
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src tests README.md *.json *.ts",
    "format:check": "prettier --check src tests README.md *.json *.ts",
    "publint": "publint",
    "attw": "attw --pack .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run publint",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.1",
    "prettier": "^3.9.5",
    "publint": "^0.3.21",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
