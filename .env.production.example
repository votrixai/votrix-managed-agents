# Copy to .env.production, replace every placeholder, and never commit it.
# scripts/gcloud/1-create-secrets.sh imports only the required values below.

# =============================================================================
# REQUIRED FOR THE STANDARD PRODUCTION CLOUD RUN PROFILE
# =============================================================================

# Runtime and checkpoint traffic uses the Supavisor transaction pooler (:6543).
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres

# LISTEN and the janitor advisory lock require a session-scoped connection.
VMA_LISTEN_DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# Alembic runs with its own session/direct secret, isolated from runtime traffic.
DATABASE_URL_DIRECT=postgresql+asyncpg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# Hosted Organization owner authentication. Use the same production Supabase
# project and publishable key as the Votrix web application.
VMA_SUPABASE_URL=https://PROJECT_REF.supabase.co
VMA_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# AES-256-GCM Vault encryption. The first database-backed tenant API key is
# created after migrations with `python -m scripts.bootstrap_api_key`; it is
# not a shared Cloud Run secret.
# Generate with:
# python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
VMA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# The checked-in Cloud Run manifest selects OpenRouter routing and E2B. Model
# credentials are stored per Organization in encrypted Vault or platform-key
# rows, never as Cloud Run model-provider secrets.
E2B_API_KEY=replace-with-e2b-api-key

# Private R2/S3 storage used by Files, Skill archives, and artifact export.
# Do not enable an r2.dev URL or public custom domain for this bucket.
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace-with-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-storage-secret-key
S3_BUCKET_NAME=votrix-managed-agents-production

# =============================================================================
# OPTIONAL
# =============================================================================

# Runtime toggles such as VMA_SERVICE_ROLE, VMA_PREVIEW_BROKER,
# VMA_EMBEDDED_WORKER_ENABLED, VMA_PUBLIC_GA_ONLY, and VMA_CORS_ORIGINS are
# pinned in the API/worker service manifests, not imported as secrets. VMA
# receives the explicit transaction-mode checkpoint DSN and session-mode
# listener DSN from the service manifests.
